PORT=3000

# Clé API Groq (https://console.groq.com/keys). Optionnelle si tu ne veux
# utiliser que l'API locale du PC fixe - dans ce cas laisse vide et
# renseigne la clé/URL directement dans l'interface.
GROQ_API_KEY=

# Modèle Groq par défaut proposé dans l'interface.
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# URL par défaut de l'API locale (ex: Ollama http://192.168.1.50:11434/v1/chat/completions
# ou vLLM http://192.168.1.50:8000/v1/chat/completions). Doit être
# compatible avec le format "chat completions" d'OpenAI.
LOCAL_API_URL=
LOCAL_API_KEY=
LOCAL_DEFAULT_MODEL=
